# Copy to .env (never commit it).
LMS_BASE=https://hendrikarisma.my.id
# Bearer token minted at https://hendrikarisma.my.id/admin/api for an account with api_access=write (staff).
LMS_TOKEN=
OLLAMA_URL=http://127.0.0.1:11434
GRADER_MODEL=qwen3:8b
EMBED_MODEL=bge-m3
GRADER_DB=data/grader.db
# Loopback by default. To reach it over a private network (e.g. WireGuard) bind that address AND set a password.
GRADER_BIND=127.0.0.1:8431
GRADER_DASH_PASSWORD=
# Python with the analyzer's requirements (python/requirements.txt)
GRADER_PYTHON=python/.venv/bin/python
